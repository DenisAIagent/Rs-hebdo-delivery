PORT=3005

# Interface d'ecoute. Ne PAS definir sur Railway (toutes interfaces).
# Utile pour l'app desktop qui embarque le backend : BIND_HOST=127.0.0.1
# BIND_HOST=

# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_KEY=your-service-role-key

# Anthropic (Claude API) — correction (si AI_PROVIDER=anthropic) ET mise en forme WordPress
ANTHROPIC_API_KEY=sk-ant-your-key
# Cle creee au niveau de l'organisation (et non dans un workspace) ? L'API exige
# alors l'identifiant du workspace (console Anthropic > Settings > Workspaces).
# Reglable aussi dans l'admin (ANTHROPIC_WORKSPACE_ID, non secret).
# ANTHROPIC_WORKSPACE_ID=wrkspc_...
# Modele Claude : choisi dans l'admin (app_settings.CLAUDE_MODEL) en priorite,
# sinon cette variable, sinon claude-sonnet-4-5-20250929 code en dur.
# CLAUDE_MODEL=claude-sonnet-4-5-20250929

# Moteurs de correction alternatifs (selectionnes dans l'admin : AI_PROVIDER)
# Les cles se saisissent de preference dans l'admin (app_settings) ; env = fallback.
# GEMINI_API_KEY=AIza...
# MISTRAL_API_KEY=...

# Moteur "claude-code" (local uniquement, ne fonctionne pas sur Railway) :
# lance la CLI Claude Code avec l'abonnement (OAuth), sans la cle API.
# CLAUDE_CODE_BIN=claude
# CLAUDE_CODE_MODEL=sonnet

# Dropbox
DROPBOX_APP_KEY=your-app-key
DROPBOX_APP_SECRET=your-app-secret
DROPBOX_REFRESH_TOKEN=your-refresh-token
DROPBOX_ROOT_FOLDER=/Hebdo Delivery

# Email notifications (Resend — https://resend.com)
# Les deux adresses recoivent les notifications de livraison ET les alertes d'echec WordPress.
RESEND_API_KEY=re_your-api-key
RESEND_FROM_EMAIL=RS Hebdo <onboarding@resend.dev>
NOTIFY_EMAIL_ALMA=alma@rollingstone.fr
NOTIFY_EMAIL_DENIS=denis@rollingstone.fr

# WordPress (optionnel) — module pilote depuis l'admin (Parametres > WordPress)
# Auth par mot de passe application WP (profil utilisateur > Mots de passe d'application).
# getWpConfig() lit app_settings en priorite puis retombe sur process.env.
# Recommandation securite : en production, definir WORDPRESS_APP_PASSWORD comme
# variable d'environnement (Railway) plutot que dans app_settings (stockage en clair).
# WORDPRESS_URL doit etre en HTTPS et resoudre vers une IP publique (anti-SSRF).
# WORDPRESS_ENABLED=false
# WORDPRESS_URL=https://www.rollingstone.fr
# WORDPRESS_USERNAME=rs_delivery
# WORDPRESS_APP_PASSWORD=xxxx xxxx xxxx xxxx xxxx xxxx
# Le mapping des cles de metas du theme (Style Music, Main Artist, Reviewer) n'est
# PAS une variable d'environnement : reglage WP_META_MAP dans app_settings (voir DOCUMENTATION.md §4).

# Double authentification TOTP : reglable depuis l'admin (Parametres > Double authentification).
# Mettre "true" ici force son activation cote serveur, quel que soit le reglage admin.
# REQUIRE_MFA=true

# Setup security token (required for /api/setup/configure)
SETUP_SECRET_TOKEN=generate-a-random-string-here

# Frontend URL (CORS)
FRONTEND_URL=http://localhost:5173
